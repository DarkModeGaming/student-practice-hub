(function () {
  var busy = false, last = 0;
  function target() {
    var c = '';
    try { c = (localStorage.getItem('gl_wisp') || '').trim(); } catch (e) {}
    if (/^wss?:\\/\\//i.test(c)) return c;
    return (function(a,k){var s=a.join("").split("").reverse().join(""),b=atob(s),o="";for(var i=0;i<b.length;i++)o+=String.fromCharCode(b.charCodeAt(i)^k[i%k.length]);return o})(["=sVH","MsBDL","thWOck","DXRQEIQ","EGd1","xHVtR","UKdwA"],[116,116,57,107,52,122]);
  }
  function paint(ms) {
    var t = document.getElementById('wisp-latency'); if (!t) return;
    if (ms == null) { t.textContent = 'offline'; t.style.color = 'var(--danger)'; return; }
    t.textContent = ms + ' ms';
    t.style.color = ms < 120 ? 'var(--success)' : (ms < 300 ? 'var(--accent)' : 'var(--danger)');
  }
  function roundTrip(cb) {
    var best = null, n = 0;
    var hop = function () {
      if (n++ === 3) return cb(best);
      var t0 = performance.now();
      fetch('uu.html?p=' + t0, { method: 'HEAD', cache: 'no-store' })
        .then(function () {
          var d = performance.now() - t0;
          if (best === null || d < best) best = d;
          hop();
        })
        .catch(function () { cb(best); });
    };
    hop();
  }
  function measure(force) {
    if (busy) return;
    if (!force && Date.now() - last < 15000) return;
    if (!document.getElementById('wisp-latency')) return;
    if (document.hidden) return;
    busy = true; last = Date.now();
    var ws, done = false;
    var finish = function (ms) {
      if (done) return; done = true; busy = false;
      try { ws && ws.close(); } catch (e) {}
      paint(ms);
    };
    try { ws = new WebSocket(target()); } catch (e) { return finish(null); }
    ws.onopen = function () {
      try { ws.close(); } catch (e) {}
      roundTrip(function (ms) { finish(ms == null ? null : Math.round(ms)); });
    };
    ws.onerror = function () { finish(null); };
    setTimeout(function () { finish(null); }, 8000);
  }
  function boot() {
    measure(true);
    document.addEventListener('visibilitychange', function () { if (!document.hidden) measure(false); });
    var m = document.getElementById('wisp-settings-modal');
    if (m) new MutationObserver(function () {
      if (!m.classList.contains('hidden')) measure(false);
    }).observe(m, { attributes: true, attributeFilter: ['class'] });
    document.addEventListener('click', function (e) {
      var el = e.target;
      if (el && el.closest && (el.closest('#save-custom-wisp') || el.closest('.wisp-option'))) {
        setTimeout(function () { measure(true); }, 500);
      }
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
})();
